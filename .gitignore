# Never commit
results/
cache/
reports/

# Symlinks to scratch (demos -> the expo-ft demos, runs -> checkpoints and training outputs).
# Two rules matter here:
#   * no trailing slash: for git a symlink is a file, not a directory, so `demos/` would not match it;
#   * a leading slash: a bare `demos` would also ignore scripts/demos/ (the demo tools).
/demos
/runs

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tools
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Experiment outputs (heavy, kept out of the repo)
wandb/
tensorboard/
logs/
checkpoints/
slurm-*.out

# Misc
.env
.DS_Store

# NVIDIA assets (copied by hand) and generated USD
third_party/robotiq/
.venv-isaaclab/
